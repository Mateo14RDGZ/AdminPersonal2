# Supabase (client-safe)
NEXT_PUBLIC_SUPABASE_URL=
# Recommended current key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative; leave empty when using the publishable key above
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server only — never expose to the client or commit)
SUPABASE_SECRET_KEY=
# Legacy alternative; leave empty when using the secret key above
SUPABASE_SERVICE_ROLE_KEY=

# Ingest endpoints (Shortcuts / email triggers)
INGEST_SECRET=
# UUID of your auth.users row — transactions from ingest attach to this user
INGEST_USER_ID=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact for VAPID (defaults to mailto:admin@example.com)
VAPID_SUBJECT=mailto:you@example.com

# Same value as VAPID_PUBLIC_KEY — exposed to the browser for push subscription
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Automatizaciones seguras
APP_BASE_URL=https://la-pesadilla-finanzas.vercel.app
AUTOMATION_TOKEN_PEPPER=

# Proveedores opcionales; la app funciona sin estas variables
AI_API_KEY=
AI_MODEL=
AI_PROVIDER=
OCR_API_KEY=
OCR_PROVIDER=
